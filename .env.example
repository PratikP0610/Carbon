# Carbon 1.0.0 Environment Configuration Template
# Copy this file to .env to customize local defaults.

# Local Loopback API Configuration
# Never expose this API to 0.0.0.0 or public interfaces
CARBON_API_HOST=127.0.0.1
CARBON_API_PORT=8765
CARBON_API_TOKEN=

# Model Runtime & Provider Configuration
CARBON_OLLAMA_BASE_URL=http://127.0.0.1:11434
CARBON_PRIMARY_MODEL=qwen3.5:9b
CARBON_INFERENCE_TIMEOUT_SECONDS=60.0

# Persistence & Data Storage
CARBON_DATA_DIR=data
CARBON_DATABASE_PATH=data/carbon.db

# Governance & Autonomy
# Autonomy levels: A0 (Observe), A1 (Assist/Recommend), A2 (Execute Approved), A3 (Bounded Autonomy)
CARBON_AUTONOMY_LEVEL=A1
# Default permission level for tool execution
CARBON_MAX_AUTO_PERMISSION_LEVEL=P1

# Diagnostics & Logging
CARBON_LOG_LEVEL=INFO
CARBON_ENABLE_AUDIT_LOG=true
CARBON_AUDIT_LOG_PATH=data/audit.log
